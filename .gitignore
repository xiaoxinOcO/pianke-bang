**/node_modules/
**/dist/
**/target/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/chroma_db/
*.log

# 编辑器和系统文件
**/.idea/
.DS_Store
Thumbs.db
*.local
