# 云服务器上复制为本文件同目录的 aliyun.env 后填写（勿提交真实密钥到 Git）
#   sudo cp aliyun.env.example /opt/campus/aliyun.env && sudo nano /opt/campus/aliyun.env
#   sudo chmod 600 /opt/campus/aliyun.env && sudo chown root:root /opt/campus/aliyun.env
#
# 各微服务 systemd 单元通过 EnvironmentFile 引用此文件（短信验证码等需要）

ALIBABA_CLOUD_ACCESS_KEY_ID=your-aliyun-ak
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-aliyun-sk

# 服务间内部凭证（与 application-secret.yml 中 CAMPUS_INTERNAL_TOKEN 保持一致）
CAMPUS_INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# 头像图片审核（视觉智能 imageaudit，与短信可共用同一 AccessKey，需已开通对应产品）
# ALIYUN_IMAGE_AUDIT_ENABLED=true
# ALIYUN_IMAGE_AUDIT_ENDPOINT=imageaudit.cn-shanghai.aliyuncs.com
# ALIYUN_IMAGE_AUDIT_SCENES=porn,ad,terrorism,live
# IMAGE_AUDIT_PUBLIC_BASE_URL=https://api.xiaoxin1.xyz
# ALIYUN_IMAGE_AUDIT_FAIL_OPEN=true
