# DeepSeek（生成 / 路由）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 向量检索（已有 retrieve_server）
RAG_VECTOR_URL=http://127.0.0.1:8765

# Java audit-service 内部工具回调
JAVA_TOOLS_URL=http://127.0.0.1:8104/internal/support/run-tools
# 与 application-campus-shared.yml 的 app.agent.graph.internal-token 一致（可空）
CAMPUS_AGENT_GRAPH_TOKEN=

# Graph 服务监听
AGENT_GRAPH_HOST=127.0.0.1
AGENT_GRAPH_PORT=8766
