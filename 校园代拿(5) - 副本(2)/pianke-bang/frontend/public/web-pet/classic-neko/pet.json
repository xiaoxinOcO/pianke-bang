{
  "name": "Neko",
  "version": "1.1.0",
  "author": "Naudy Castellanos / NekoAI",
  "description": "The original Neko cat, adapted for web",
  "personality": "Neko is a playful, curious cat who speaks in short bursts.",
  "spritesDir": "sprites",
  "displayScale": 2,
  "animations": {
    "idle": { "files": ["awake.png"], "fps": 2, "loop": true },
    "awaken": { "files": ["awake.png"], "fps": 6, "loop": false },
    "walk_right": { "files": ["right1.png", "right2.png"], "fps": 4, "loop": true },
    "walk_left": { "files": ["left1.png", "left2.png"], "fps": 4, "loop": true },
    "walk_up": { "files": ["up1.png", "up2.png"], "fps": 4, "loop": true },
    "walk_down": { "files": ["down1.png", "down2.png"], "fps": 4, "loop": true },
    "walk_up_right": { "files": ["upright1.png", "upright2.png"], "fps": 4, "loop": true },
    "walk_up_left": { "files": ["upleft1.png", "upleft2.png"], "fps": 4, "loop": true },
    "walk_down_right": { "files": ["downright1.png", "downright2.png"], "fps": 4, "loop": true },
    "walk_down_left": { "files": ["downleft1.png", "downleft2.png"], "fps": 4, "loop": true },
    "yawn": { "files": ["yawn2.png", "yawn3.png"], "fps": 3, "loop": false },
    "sleep": { "files": ["sleep1.png", "sleep2.png"], "fps": 2, "loop": true },
    "happy": { "files": ["scratch1.png", "scratch2.png"], "fps": 8, "loop": false },
    "thinking": { "files": ["awake.png"], "fps": 2, "loop": true },
    "scratch_left": { "files": ["leftclaw1.png", "leftclaw2.png"], "fps": 5, "loop": true },
    "scratch_right": { "files": ["rightclaw1.png", "rightclaw2.png"], "fps": 5, "loop": true },
    "scratch_up": { "files": ["upclaw1.png", "upclaw2.png"], "fps": 5, "loop": true },
    "scratch_down": { "files": ["downclaw1.png", "downclaw2.png"], "fps": 5, "loop": true },
    "peek_idle": { "files": ["awake.png"], "fps": 2, "loop": true }
  }
}
