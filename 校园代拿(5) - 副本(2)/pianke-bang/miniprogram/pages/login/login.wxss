.login-page {
  position: relative;
  min-height: 100vh;
  margin: -20rpx -28rpx 0;
  padding: 96rpx 48rpx calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(120% 420rpx at 50% -40rpx, rgba(18, 168, 85, 0.18), transparent 70%),
    #f7f6f3;
}

.brand {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-glow {
  position: absolute;
  top: 8rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(18, 168, 85, 0.16);
  filter: blur(8rpx);
}

.brand-logo {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 18rpx 40rpx rgba(27, 36, 48, 0.08);
}

.brand-wordmark {
  position: relative;
  display: block;
  height: 52rpx;
  width: auto;
  margin-top: 28rpx;
}

.brand-sub {
  position: relative;
  font-size: 24rpx;
  color: #8a847c;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.login-page .segment-tabs {
  background: transparent;
  border-radius: 0;
  padding: 0;
  margin: 0 8rpx 28rpx;
  gap: 40rpx;
  justify-content: center;
}

.login-page .segment-tab {
  flex: none;
  font-size: 32rpx;
  color: #9a948c;
  padding: 8rpx 4rpx 14rpx;
  border-radius: 0;
  border-bottom: 4rpx solid transparent;
}

.login-page .segment-tab.active {
  background: transparent;
  color: #1b2430;
  box-shadow: none;
  border-bottom-color: #12a855;
}

.login-page .form-card {
  padding: 36rpx 32rpx 32rpx;
  border: none;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(27, 36, 48, 0.06);
}

.login-type-tabs {
  display: flex;
  gap: 28rpx;
  margin-bottom: 32rpx;
}

.lt-tab {
  font-size: 26rpx;
  color: #9a948c;
  padding: 8rpx 0 10rpx;
  border-radius: 0;
  border: none;
  border-bottom: 3rpx solid transparent;
}

.lt-tab.active {
  background: transparent;
  color: #12a855;
  border-color: transparent;
  border-bottom-color: #12a855;
  font-weight: 600;
}

.login-page .field,
.login-page .input.field {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-bottom: 18rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #f6f5f2;
  border: none;
  border-radius: 22rpx;
  font-size: 30rpx;
}

.forgot-row {
  display: flex;
  justify-content: flex-end;
  margin: -4rpx 4rpx 8rpx;
}

.forgot-link {
  font-size: 24rpx;
  color: #12a855;
  padding: 8rpx 0;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0;
}

.code-btn {
  flex-shrink: 0;
  font-size: 24rpx !important;
  padding: 0 22rpx !important;
  line-height: 72rpx !important;
  height: 72rpx;
  border-radius: 18rpx !important;
  background: #f3faf5 !important;
  color: #12a855 !important;
  border: none !important;
}

.login-page .submit-btn {
  width: 100%;
  margin-top: 20rpx;
  height: 96rpx;
  line-height: 96rpx !important;
  padding: 0 !important;
  border-radius: 24rpx !important;
  background: #12a855 !important;
  font-size: 32rpx !important;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(18, 168, 85, 0.28);
}

.submit-btn[disabled] {
  opacity: 0.65;
  box-shadow: none;
}

.pick-list {
  margin-top: 8rpx;
}

.pick-title {
  font-size: 24rpx;
  color: #8a847c;
  display: block;
  margin-bottom: 12rpx;
}

.pick-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: #f6f5f2;
  border-radius: 22rpx;
  margin-bottom: 12rpx;
  color: #1b2430;
  border: none;
}

.pick-item-hover {
  background: #eef7f1;
}

.pick-avatar-wrap,
.pick-avatar-img,
.pick-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
}

.pick-avatar-wrap {
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f8ef;
}

.pick-avatar-img {
  display: block;
}

.pick-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #12a855;
  background: #e8f8ef;
}

.pick-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1b2430;
  text-align: left;
}

.pick-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
}

.skip-row {
  margin-top: 36rpx;
  text-align: center;
  padding: 16rpx;
}

.skip-text {
  font-size: 26rpx;
  color: #8a847c;
}

.form-error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fdecec;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.5;
}
