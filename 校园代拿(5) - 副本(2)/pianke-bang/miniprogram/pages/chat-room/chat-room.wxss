.chat-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: #ebebeb;
  box-sizing: border-box;
}

.message-list {
  flex: 1;
  height: 0;
  padding: 20rpx 28rpx 0;
  box-sizing: border-box;
}

.list-bottom-spacer {
  height: 20rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}

.empty-icon {
  width: 108rpx;
  height: 84rpx;
  border: 3rpx solid rgba(140, 129, 120, 0.2);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.empty-icon::after {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 24rpx;
  height: 3rpx;
  background: rgba(140, 129, 120, 0.12);
  border-radius: 2rpx;
  box-shadow: 0 14rpx 0 rgba(140, 129, 120, 0.08), 0 28rpx 0 rgba(140, 129, 120, 0.06);
}

.empty-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

.meta-divider {
  display: flex;
  justify-content: center;
  margin: 20rpx 0 24rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.msg-row.spaced {
  margin-bottom: 20rpx;
}

.msg-row.compact {
  margin-bottom: 6rpx;
}

.msg-row.other {
  justify-content: flex-start;
  gap: 12rpx;
}

.msg-row.mine {
  justify-content: flex-end;
  gap: 12rpx;
}

.avatar-slot {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  margin-top: 2rpx;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 6rpx;
  background: #ddd;
  display: block;
}

.avatar-letter {
  width: 80rpx;
  height: 80rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.avatar-letter.other {
  background: #c4c4c4;
}

.avatar-letter.mine {
  background: #8fbc8f;
}

.msg-body {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 104rpx);
}

.msg-row.mine .msg-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.read-receipt {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
  line-height: 1.2;
  padding-right: 4rpx;
}

.bubble {
  display: inline-block;
  max-width: 100%;
  padding: 16rpx 20rpx;
  word-break: break-all;
  position: relative;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.5;
  display: block;
}

.msg-row.other .bubble {
  background: #fff;
  color: #1a1a1a;
}

.msg-row.mine .bubble {
  background: #95ec69;
  color: #1a1a1a;
}

.msg-row.other .bubble.single {
  border-radius: 4rpx 12rpx 12rpx 12rpx;
}

.msg-row.other .bubble.first {
  border-radius: 4rpx 12rpx 12rpx 12rpx;
}

.msg-row.other .bubble.middle {
  border-radius: 4rpx 12rpx 12rpx 4rpx;
}

.msg-row.other .bubble.last {
  border-radius: 4rpx 12rpx 4rpx 12rpx;
}

.msg-row.mine .bubble.single {
  border-radius: 12rpx 4rpx 12rpx 12rpx;
}

.msg-row.mine .bubble.first {
  border-radius: 12rpx 4rpx 12rpx 12rpx;
}

.msg-row.mine .bubble.middle {
  border-radius: 12rpx 4rpx 4rpx 12rpx;
}

.msg-row.mine .bubble.last {
  border-radius: 12rpx 4rpx 12rpx 4rpx;
}

.composer {
  padding: 14rpx 20rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.composer-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx 10rpx 10rpx 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.plus-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-btn.disabled {
  opacity: 0.5;
}

.plus-icon {
  font-size: 40rpx;
  line-height: 1;
  color: #666;
  font-weight: 400;
  margin-top: -4rpx;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  background: transparent;
}

.input-placeholder {
  color: #b2b2b2;
}

.send-circle {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}

.send-circle.active {
  background: #07c160;
}

.send-circle.loading {
  opacity: 0.6;
}

.send-arrow {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}

.bubble.image-bubble {
  padding: 6rpx;
  overflow: hidden;
  max-width: 420rpx;
}

.bubble-image {
  display: block;
  width: 400rpx;
  max-width: 100%;
  border-radius: 8rpx;
  background: #ddd;
}

.bubble-caption {
  display: block;
  padding: 10rpx 12rpx 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #1a1a1a;
}
