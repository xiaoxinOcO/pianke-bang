.notice-header {

  margin-bottom: 12rpx;

}



.notice-title {

  font-size: 32rpx;

  font-weight: 600;

  color: var(--text);

  flex: 1;

}



.notice-tags {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.pin-tag,
.link-tag {
  flex-shrink: 0;
}

.link-tag {
  background: rgba(37, 99, 235, 0.12);
  color: #2563eb;
}

.notice-card-hover {
  opacity: 0.92;
}

.notice-link-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--primary);
}



.notice-content {

  font-size: 28rpx;

  line-height: 1.7;

  margin-bottom: 16rpx;

  display: block;

  color: var(--text);

}



.notice-time {

  display: block;

}



.notice-empty::before {

  width: 32rpx;

  height: 40rpx;

  border: 4rpx solid var(--subtext);

  border-radius: 4rpx;

  opacity: 0.3;

}



.notice-empty::after {

  width: 20rpx;

  height: 3rpx;

  top: 72rpx;

}

