<view class="hall-page">
  <notify-toast />

  <view class="top-panel">
    <view class="brand-row">
      <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
      <view class="brand-text">
        <image class="brand-wordmark" src="/images/pianke-wordmark.png" mode="heightFix" />
        <text class="brand-sub">顺路帮忙，刚好值得</text>
      </view>
    </view>

    <view wx:if="{{topNotice}}" class="notice-strip" bindtap="goNotices">
      <text class="notice-tag">{{topNotice.linkEnabled ? '链接' : '公告'}}</text>
      <text class="notice-text">{{topNotice.title}}</text>
      <text class="notice-arrow">›</text>
    </view>

    <view class="search-row">
      <view class="search-box">
        <input
          class="search-input"
          placeholder="搜索任务标题或地点"
          placeholder-class="search-placeholder"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          confirm-type="search"
          bindconfirm="onSearch"
        />
      </view>
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <swiper
    wx:if="{{banners.length > 0}}"
    class="promo-swiper"
    autoplay
    circular
    interval="4000"
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view
        class="promo-banner promo-{{item.bannerTheme || item.theme || 'warm'}} {{item.bannerImageUrl ? 'has-image' : ''}}"
        data-index="{{index}}"
        bindtap="onBannerTap"
      >
        <image wx:if="{{item.bannerImageUrl}}" class="promo-bg" src="{{item.bannerImageUrl}}" mode="aspectFill" />
        <view wx:if="{{item.bannerImageUrl}}" class="promo-shade"></view>
        <view wx:if="{{!item.bannerImageUrl && item.actionType === 'COUPON_CLAIM' && item.amountLabel}}" class="promo-amount">{{item.amountLabel}}</view>
        <view class="promo-copy">
          <text class="promo-kicker">限时活动</text>
          <text class="promo-title">{{item.title}}</text>
          <text class="promo-sub">{{item.subtitle}}</text>
        </view>
        <view class="promo-cta {{item.claimed && item.actionType === 'COUPON_CLAIM' ? 'claimed' : ''}}">
          <text class="promo-cta-text">{{item.claimed && item.actionType === 'COUPON_CLAIM' ? '已领取' : (item.ctaText || '去看看')}}</text>
          <text wx:if="{{!(item.claimed && item.actionType === 'COUPON_CLAIM')}}" class="promo-cta-arrow">›</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <scroll-view scroll-x class="type-scroll" enhanced show-scrollbar="{{false}}">
    <view class="type-list">
      <view
        wx:for="{{taskTypes}}"
        wx:key="value"
        class="type-chip {{taskType === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onTypeTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="section-header">
    <text class="section-title">可接任务</text>
    <text class="section-link" bindtap="goMine">我的任务</text>
  </view>

  <block wx:if="{{tasks.length > 0}}">
    <task-card
      wx:for="{{tasks}}"
      wx:key="id"
      task="{{item}}"
      myName="{{myName}}"
      showActions="{{isLoggedIn}}"
      bind:tap="onTaskTap"
      bind:claim="onClaim"
    />
  </block>

  <view wx:elif="{{!loading}}" class="empty-panel">
    <view class="empty-icon"></view>
    <text class="empty-title">暂无待接任务</text>
    <text class="empty-desc">稍后再来看看，或去发布一个任务吧</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>
</view>
