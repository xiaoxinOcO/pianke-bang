.chat-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: #ebebeb;
  box-sizing: border-box;
}

.message-list {
  flex: 1;
  height: 0;
  padding: 12rpx 28rpx 0;
  box-sizing: border-box;
}

.list-bottom-spacer {
  height: 20rpx;
}

.meta-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 8rpx 0 24rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999;
}

.handoff {
  font-size: 22rpx;
  color: #576b95;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
}

.msg-row.spaced {
  margin-bottom: 20rpx;
}

.msg-row.other {
  justify-content: flex-start;
  gap: 12rpx;
}

.msg-row.mine {
  justify-content: flex-end;
  gap: 12rpx;
}

.avatar-slot {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: transparent;
  display: block;
  transform: scale(1.14);
}

.avatar-letter {
  width: 80rpx;
  height: 80rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.avatar-letter.other {
  background: #c4c4c4;
}

.avatar-letter.mine {
  background: #8fbc8f;
}

.msg-body {
  flex: 0 1 auto;
  min-width: 0;
  max-width: calc(100% - 104rpx);
}

.msg-row.mine .msg-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bubble {
  display: inline-block;
  max-width: 100%;
  padding: 16rpx 20rpx;
  word-break: break-all;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.5;
  display: block;
  white-space: pre-wrap;
}

.msg-row.other .bubble {
  background: #fff;
  color: #1a1a1a;
  border-radius: 4rpx 12rpx 12rpx 12rpx;
}

.msg-row.mine .bubble {
  background: #95ec69;
  color: #1a1a1a;
  border-radius: 12rpx 4rpx 12rpx 12rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 92rpx 16rpx;
}

.quick {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #576b95;
  background: #fff;
  border-radius: 8rpx;
}

.rating-card {
  margin: 8rpx 0 20rpx;
  padding: 24rpx 22rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.rating-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 18rpx;
}

.rating-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.rating-agent {
  font-size: 24rpx;
  color: #888;
}

.rating-stars {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.rating-star {
  font-size: 44rpx;
  color: #d9d9d9;
  line-height: 1;
}

.rating-star.on {
  color: #f5a623;
}

.rating-score-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.rating-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.rating-tag {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.rating-tag.on {
  color: #07c160;
  background: rgba(7, 193, 96, 0.12);
}

.rating-comment {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #1a1a1a;
  background: #f7f7f7;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
}

.rating-actions {
  display: flex;
  gap: 16rpx;
}

.rating-skip,
.rating-submit {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.rating-skip {
  color: #666;
  background: #f0f0f0;
}

.rating-submit {
  color: #fff;
  background: #07c160;
}

.rating-skip.disabled,
.rating-submit.disabled {
  opacity: 0.55;
}

.composer {
  padding: 14rpx 20rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.composer-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx 10rpx 10rpx 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  background: transparent;
}

.input-placeholder {
  color: #b2b2b2;
}

.send-circle {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-circle.active {
  background: #07c160;
}

.send-circle.loading {
  opacity: 0.6;
}

.send-arrow {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}
