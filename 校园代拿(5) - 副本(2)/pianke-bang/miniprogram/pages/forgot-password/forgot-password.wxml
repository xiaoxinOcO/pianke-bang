<view class="page forgot-page">
  <view class="hero">
    <text class="hero-title">重置密码</text>
    <text class="hero-desc">用注册手机号验证身份后，设置新密码</text>
  </view>

  <view class="card form-card">
    <view wx:if="{{formError}}" class="form-error">{{formError}}</view>

    <input
      class="input field"
      placeholder="注册手机号"
      placeholder-class="input-placeholder"
      type="number"
      maxlength="11"
      data-field="phone"
      value="{{phone}}"
      bindinput="onInput"
    />

    <view class="code-row">
      <input
        class="input field code-input"
        placeholder="短信验证码"
        placeholder-class="input-placeholder"
        type="number"
        maxlength="6"
        data-field="code"
        value="{{code}}"
        bindinput="onInput"
      />
      <button class="btn-ghost code-btn" disabled="{{countdown > 0 || sending}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
      </button>
    </view>

    <view wx:if="{{verified}}" class="verify-ok">
      <text class="verify-ok-text">已验证 · {{selectedUsername || '账号'}}</text>
      <text wx:if="{{accounts.length > 1}}" class="verify-ok-action" bindtap="clearAccountPick">重选账号</text>
    </view>

    <view wx:if="{{accounts.length > 0 && !selectedUserId}}" class="pick-list">
      <text class="pick-title">该手机号绑定多个账号，请选择要重置的账号</text>
      <view
        wx:for="{{accounts}}"
        wx:key="userId"
        class="pick-item"
        data-user-id="{{item.userId}}"
        data-username="{{item.username}}"
        bindtap="onPickAccount"
        hover-class="pick-item-hover"
      >
        <view class="pick-avatar-wrap">
          <image
            wx:if="{{item.avatarUrl}}"
            class="pick-avatar-img"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="pick-avatar-fallback">{{item.avatarInitial}}</view>
        </view>
        <text class="pick-name">{{item.username}}</text>
        <text class="pick-arrow">›</text>
      </view>
    </view>

    <block wx:if="{{verified && selectedUserId}}">
      <input
        class="input field"
        placeholder="新密码（6-32位）"
        placeholder-class="input-placeholder"
        password
        data-field="newPassword"
        value="{{newPassword}}"
        bindinput="onInput"
      />
      <input
        class="input field"
        placeholder="再次输入新密码"
        placeholder-class="input-placeholder"
        password
        data-field="confirmPassword"
        value="{{confirmPassword}}"
        bindinput="onInput"
      />
      <button class="btn-primary submit-btn" disabled="{{submitting}}" bindtap="onSubmit">
        {{submitting ? '提交中...' : '确认重置'}}
      </button>
    </block>

    <button
      wx:elif="{{!verified}}"
      class="btn-primary submit-btn"
      disabled="{{verifying}}"
      bindtap="onVerify"
    >
      {{verifying ? '验证中...' : '下一步'}}
    </button>
  </view>

  <view class="back-row" bindtap="goLogin">
    <text class="back-text">返回登录</text>
  </view>
</view>
