<view class="page">
  <view wx:if="{{messages.length > 0}}">
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="card notice-item {{item.readFlag ? '' : 'unread'}} {{item.canOpenTask ? 'tappable' : ''}}"
      data-task-id="{{item.taskId}}"
      bindtap="onOpenNotice"
    >
      <view class="notice-head">
        <text class="notice-title">{{item.title || '系统通知'}}</text>
        <text wx:if="{{!item.readFlag}}" class="unread-dot"></text>
        <text wx:if="{{item.canOpenTask}}" class="notice-link">查看订单</text>
      </view>
      <text class="notice-content">{{item.content}}</text>
      <text class="notice-time">{{item.timeText}}</text>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty-wrap">
    <view class="empty-illustration"></view>
    <text class="empty-title">暂无系统通知</text>
    <text class="empty-desc">任务状态、钱包变动等消息会显示在这里</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-dots">加载中</text>
  </view>
</view>
