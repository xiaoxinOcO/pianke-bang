<view class="coupons-page">
  <view class="center-entry" bindtap="goCenter">领取新人礼包 / 兑换码 ›</view>
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab {{statusFilter === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="id" class="coupon-card {{item.status === 'UNUSED' ? '' : 'used'}}">
      <view class="coupon-left">
        <text class="coupon-name">{{item.name || '优惠券'}}</text>
        <text class="coupon-desc">{{item.descText}}</text>
        <text class="coupon-expire" wx:if="{{item.expireText}}">有效期至 {{item.expireText}}</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-status">{{item.statusText}}</text>
      </view>
    </view>
  </block>

  <view wx:elif="{{!loading}}" class="empty-wrap">
    <text class="empty-title">暂无优惠券</text>
    <text class="empty-desc">发布任务支付赏金时可抵扣</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中</text>
  </view>
</view>
