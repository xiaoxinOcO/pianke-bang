.wallet-page {
  min-height: 100vh;
  background: #ededed;
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.balance-card {
  background: linear-gradient(135deg, #07c160 0%, #4cd964 100%);
  border-radius: 20rpx;
  padding: 40rpx 28rpx 28rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.balance-label {
  font-size: 26rpx;
  opacity: 0.92;
  display: block;
}

.balance-value {
  font-size: 64rpx;
  font-weight: 700;
  display: block;
  margin: 12rpx 0 8rpx;
  letter-spacing: 2rpx;
}

.balance-sub {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 28rpx !important;
  border-radius: 36rpx !important;
  border: none !important;
}

.action-btn::after {
  border: none !important;
}

.action-btn.primary {
  background: #fff !important;
  color: #07c160 !important;
  font-weight: 600 !important;
}

.action-btn.ghost {
  background: rgba(255, 255, 255, 0.18) !important;
  color: #fff !important;
  border: 2rpx solid rgba(255, 255, 255, 0.55) !important;
}

.tip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.tx-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.tx-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tx-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.tx-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.tx-amount.income {
  color: #2e7d5a;
}

.tx-amount.expense {
  color: #ef4444;
}

.tx-remark,
.tx-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 64rpx 40rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.wallet-empty::before {
  width: 36rpx;
  height: 28rpx;
  border: 4rpx solid #bbb;
  border-radius: 6rpx;
  opacity: 0.35;
}

.wallet-empty::after {
  display: none;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
