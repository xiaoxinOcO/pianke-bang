<view class="page">

  <view class="card">

    <text class="section-title">反馈类型</text>

    <radio-group class="type-group" bindchange="onTypeChange">

      <label class="radio-item">

        <radio value="suggest" checked color="#07c160" />

        <text>功能建议</text>

      </label>

      <label class="radio-item">

        <radio value="bug" color="#07c160" />

        <text>问题反馈</text>

      </label>

    </radio-group>

  </view>



  <view class="card">

    <text class="section-title">反馈内容</text>

    <textarea

      class="textarea feedback-input"

      placeholder="请描述你的建议或遇到的问题..."

      value="{{content}}"

      bindinput="onInput"

      maxlength="500"

    />

    <text class="char-count">{{content.length || 0}}/500</text>

  </view>



  <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmit">提交反馈</button>

</view>

