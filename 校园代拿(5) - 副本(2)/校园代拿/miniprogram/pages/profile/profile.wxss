.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-card.guest {
  flex-direction: column;
  text-align: center;
  padding: 48rpx 28rpx;
}

.guest-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  border: 3rpx dashed var(--border);
  margin-bottom: 16rpx;
  position: relative;
}

.guest-avatar::before {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--subtext);
  border-radius: 50%;
  opacity: 0.4;
}

.guest-avatar::after {
  content: '';
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 24rpx;
  border: 3rpx solid var(--subtext);
  border-bottom: none;
  border-radius: 24rpx 24rpx 0 0;
  opacity: 0.4;
}

.guest-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.avatar-img,
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.avatar {
  background: var(--primary-gradient);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit text {
  font-size: 18rpx;
  color: #fff;
  line-height: 1;
}

.username {
  font-size: 34rpx;
  font-weight: 600;
  display: block;
}

.badge-row {
  margin-top: 8rpx;
}

.pending-tag {
  background: #fff3e0;
  color: #e65100;
}

.logout-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* 菜单小图标 */
.mi-task,
.mi-wallet,
.mi-coupon,
.mi-rider,
.mi-notice,
.mi-feedback {
  position: relative;
}

.mi-task {
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid #07c160;
  border-radius: 3rpx;
}

.mi-wallet {
  width: 24rpx;
  height: 18rpx;
  border: 3rpx solid #0f9d8a;
  border-radius: 4rpx;
}

.mi-wallet::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 6rpx;
  border: 3rpx solid #0f9d8a;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

.mi-coupon {
  width: 26rpx;
  height: 18rpx;
  border: 3rpx solid #e67e22;
  border-radius: 4rpx;
}

.mi-coupon::before,
.mi-coupon::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #e67e22;
  top: 50%;
  transform: translateY(-50%);
}

.mi-coupon::before {
  left: -7rpx;
}

.mi-coupon::after {
  right: -7rpx;
}

.mi-rider {
  width: 24rpx;
  height: 16rpx;
  border: 3rpx solid #4a7fd4;
  border-radius: 8rpx;
}

.mi-rider::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 6rpx;
  height: 6rpx;
  background: #4a7fd4;
  border-radius: 50%;
}

.mi-notice {
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid #d4a017;
  border-radius: 3rpx;
}

.mi-notice::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 4rpx;
  width: 12rpx;
  height: 3rpx;
  background: #d4a017;
  border-radius: 2rpx;
}

.mi-feedback {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #7b6bb5;
  border-radius: 50%;
}

.mi-feedback::after {
  content: '?';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 16rpx;
  color: #7b6bb5;
  font-weight: 700;
  line-height: 1;
}
