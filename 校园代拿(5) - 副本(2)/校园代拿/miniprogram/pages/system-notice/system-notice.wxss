.notice-item.unread {
  border-left: 6rpx solid var(--primary);
}

.notice-item.tappable:active {
  opacity: 0.92;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.notice-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.notice-content {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.notice-time {
  display: block;
  font-size: 22rpx;
  color: var(--subtext);
}
