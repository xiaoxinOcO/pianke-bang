<view class="page">

  <block wx:if="{{notices.length > 0}}">

    <view wx:for="{{notices}}" wx:key="id" class="notice-card card">

      <view class="flex-between notice-header">

        <text class="notice-title">{{item.title}}</text>

        <text wx:if="{{item.pinned}}" class="tag pin-tag">置顶</text>

      </view>

      <text class="notice-content">{{item.content}}</text>

      <text class="subtext notice-time">{{item.timeText}}</text>

    </view>

  </block>



  <view wx:else class="empty-wrap">

    <view class="empty-illustration notice-empty"></view>

    <text class="empty-title">暂无公告</text>

    <text class="empty-desc">平台公告会在这里发布</text>

  </view>

</view>

