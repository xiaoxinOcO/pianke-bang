.forgot-page {
  padding-top: 40rpx;
}

.hero {
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--subtext);
  line-height: 1.5;
}

.form-card {
  padding: 36rpx 28rpx;
}

.field {
  width: 100%;
  margin-bottom: 20rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0;
}

.code-btn {
  flex-shrink: 0;
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  line-height: 80rpx !important;
  height: 80rpx;
}

.verify-ok {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #e8f8ef;
}

.verify-ok-text {
  font-size: 26rpx;
  color: #059669;
  font-weight: 600;
}

.verify-ok-action {
  font-size: 24rpx;
  color: var(--primary);
}

.pick-list {
  margin-bottom: 8rpx;
}

.pick-title {
  display: block;
  font-size: 24rpx;
  color: var(--subtext);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.pick-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-soft);
  border-radius: var(--radius-md);
  margin-bottom: 12rpx;
  border: 1rpx solid var(--border);
}

.pick-item-hover {
  background: #eef7f1;
}

.pick-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f8ef;
}

.pick-avatar-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.pick-avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #07c160;
  background: #e8f8ef;
}

.pick-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.pick-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #c0c4cc;
  line-height: 1;
}

.submit-btn {
  width: 100%;
  margin-top: 12rpx;
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.form-error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fdeaea;
  color: #ef4444;
  font-size: 24rpx;
  line-height: 1.5;
}

.back-row {
  margin-top: 36rpx;
  text-align: center;
  padding: 20rpx;
}

.back-text {
  font-size: 26rpx;
  color: var(--subtext);
}
