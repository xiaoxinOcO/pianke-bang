<view class="page">
  <view class="hero">
    <view class="illus" aria-hidden="true">
      <view class="illus-monitor"></view>
      <view class="illus-phone"></view>
    </view>
    <text class="title">即将在电脑上登录片刻帮</text>
    <text class="sub">{{info || '请确认是否是本人操作'}}</text>
    <text wx:if="{{username}}" class="account">当前账号：{{username}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{done}}">
    <view class="done-card">
      <text class="done-title">已确认登录</text>
      <text class="done-desc">请回到电脑端继续使用</text>
    </view>
  </block>

  <block wx:elif="{{needLogin}}">
    <button class="btn-primary" bindtap="goLogin">先登录小程序</button>
    <button class="btn-ghost" bindtap="onCancel">取消</button>
  </block>

  <block wx:else>
    <button class="btn-primary" disabled="{{submitting || !ticket}}" bindtap="onConfirmLogin">
      {{submitting ? '确认中…' : '确认登录'}}
    </button>
    <button class="btn-ghost" disabled="{{submitting}}" bindtap="onCancel">取消</button>
  </block>
</view>
