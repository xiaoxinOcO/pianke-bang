.page {
  min-height: 100vh;
  padding: 72rpx 48rpx 80rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.illus {
  width: 280rpx;
  height: 180rpx;
  position: relative;
  margin-bottom: 36rpx;
}

.illus-monitor {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  width: 160rpx;
  height: 110rpx;
  border: 6rpx solid #1f2937;
  border-radius: 12rpx;
  background: #fff;
}

.illus-monitor::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -28rpx;
  width: 56rpx;
  height: 20rpx;
  transform: translateX(-50%);
  background: #1f2937;
  border-radius: 4rpx;
}

.illus-phone {
  position: absolute;
  right: 28rpx;
  top: 48rpx;
  width: 70rpx;
  height: 120rpx;
  border: 6rpx solid #2563eb;
  border-radius: 14rpx;
  background: #eff6ff;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.5;
}

.account {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #2563eb;
}

.error {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 1.5;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border: none;
}

.btn-primary::after,
.btn-ghost::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #374151;
  border: 2rpx solid #d1d5db;
}

.done-card {
  padding: 48rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.done-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.done-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}
