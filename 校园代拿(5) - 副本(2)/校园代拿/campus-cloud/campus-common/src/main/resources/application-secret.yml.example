# 复制为 application-secret.yml（同目录）后填写真实值。该文件已 gitignore，勿提交。
# cp application-secret.yml.example application-secret.yml

MYSQL_USER: root
MYSQL_PASSWORD: "your-mysql-password"

APP_JWT_SECRET: "replace-with-a-long-random-string"

DEEPSEEK_API_KEY: "sk-your-deepseek-key"
CAMPUS_LLM_API_KEY: "sk-your-deepseek-key"

ALIBABA_CLOUD_ACCESS_KEY_ID: "your-aliyun-ak"
ALIBABA_CLOUD_ACCESS_KEY_SECRET: "your-aliyun-sk"

CAMPUS_INTERNAL_TOKEN: "replace-with-a-long-random-internal-token"

# 支付宝沙箱应用私钥
ALIPAY_PRIVATE_KEY: "your-alipay-app-private-key"
